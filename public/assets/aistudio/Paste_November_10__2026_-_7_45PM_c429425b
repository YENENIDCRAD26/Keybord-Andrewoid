import React, { useState, useEffect, useRef } from 'react';
import { 
  X, 
  Minus, 
  ChevronUp, 
  ChevronDown, 
  Globe, 
  Delete, 
  CornerDownLeft,
  Keyboard as KeyboardIcon,
  Smartphone,
  Sparkles,
  Bold,
  Italic,
  Underline,
  RotateCcw,
  RotateCw,
  Save,
  Printer,
  AlignRight,
  AlignCenter,
  AlignLeft,
  List,
  ListOrdered,
  DollarSign,
  Percent,
  Plus,
  Trash2,
  Strikethrough,
  Table,
  Palette,
  ArrowUp,
  ArrowDown,
  ArrowLeft,
  ArrowRight,
  Check,
  Zap
} from 'lucide-react';
import { VirtualKeyboardState } from '../types';
import { getPredictiveSuggestions, TextSuggestion } from '../utils/predictiveTextEngine';

interface ArabVirtualKeyboardProps {
  state: VirtualKeyboardState;
  onUpdateState: (partial: Partial<VirtualKeyboardState>) => void;
  onKeyPress: (char: string) => void;
  onBackspace: () => void;
  onEnter: () => void;
  onTab: () => void;
  onArrowKey?: (dir: 'up' | 'down' | 'left' | 'right') => void;
  onCommand?: (cmd: string) => void;
  onInsertText?: (text: string, replaceLength?: number) => void;
  mode: 'word' | 'excel';
}

export const ArabVirtualKeyboard: React.FC<ArabVirtualKeyboardProps> = ({
  state,
  onUpdateState,
  onKeyPress,
  onBackspace,
  onEnter,
  onTab,
  onArrowKey,
  onCommand,
  onInsertText,
  mode
}) => {
  const [isMinimized, setIsMinimized] = useState(false);
  const [showExtraMenu, setShowExtraMenu] = useState(false);
  const [showColorPalette, setShowColorPalette] = useState(false);
  const [showShortcutsBar, setShowShortcutsBar] = useState(true);
  const [showShortcutsModal, setShowShortcutsModal] = useState(false);

  // Predictive Text State
  const [predictiveBuffer, setPredictiveBuffer] = useState<string>('');
  const [predictiveSuggestions, setPredictiveSuggestions] = useState<TextSuggestion[]>([]);
  const inactivityTimerRef = useRef<NodeJS.Timeout | null>(null);

  // Reset predictive suggestions and buffer
  const clearPredictions = () => {
    setPredictiveBuffer('');
    setPredictiveSuggestions([]);
    if (inactivityTimerRef.current) {
      clearTimeout(inactivityTimerRef.current);
      inactivityTimerRef.current = null;
    }
  };

  // Update suggestions whenever predictive buffer changes
  useEffect(() => {
    if (!predictiveBuffer.trim()) {
      setPredictiveSuggestions([]);
      return;
    }

    const suggestions = getPredictiveSuggestions(
      predictiveBuffer,
      state.language,
      mode,
      6
    );
    setPredictiveSuggestions(suggestions);

    // Auto-inactivity timeout: dismiss transparent prediction bar after 7 seconds of inactivity
    if (inactivityTimerRef.current) {
      clearTimeout(inactivityTimerRef.current);
    }
    inactivityTimerRef.current = setTimeout(() => {
      clearPredictions();
    }, 7000);

    return () => {
      if (inactivityTimerRef.current) {
        clearTimeout(inactivityTimerRef.current);
      }
    };
  }, [predictiveBuffer, state.language, mode]);

  if (!state.isOpen) return null;

  const isNative = state.preferredInputMode === 'native';
  const autoSwitchEnabled = state.autoSwitch !== false;
  const layoutMode = state.layoutMode || 'standard'; // 'standard' (Windows 101) or 'rtl' (Arabic reading flow)
  const numberType = state.numberType || 'eastern'; // 'eastern' (١٢٣) or 'western' (123)

  const toggleInputMode = () => {
    onUpdateState({ preferredInputMode: isNative ? 'virtual' : 'native' });
  };

  const toggleAutoSwitch = () => {
    onUpdateState({ autoSwitch: !autoSwitchEnabled });
  };

  const toggleLanguage = () => {
    clearPredictions();
    onUpdateState({ language: state.language === 'ar' ? 'en' : 'ar' });
  };

  const toggleShift = () => {
    onUpdateState({ shiftActive: !state.shiftActive });
  };

  const toggleAlt = () => {
    onUpdateState({ altActive: !state.altActive });
  };

  const toggleCtrl = () => {
    onUpdateState({ ctrlActive: !state.ctrlActive });
  };

  const toggleLayoutMode = () => {
    onUpdateState({ layoutMode: layoutMode === 'standard' ? 'rtl' : 'standard' });
  };

  const toggleNumberType = () => {
    onUpdateState({ numberType: numberType === 'eastern' ? 'western' : 'eastern' });
  };

  // Select a predictive suggestion
  const handleSelectSuggestion = (suggestion: TextSuggestion) => {
    const textToInsert = suggestion.text + (suggestion.text.endsWith(' ') || suggestion.text.endsWith('(') ? '' : ' ');
    const replaceLen = predictiveBuffer.length;

    if (onInsertText) {
      onInsertText(textToInsert, replaceLen);
    } else {
      for (let i = 0; i < replaceLen; i++) {
        onBackspace();
      }
      onKeyPress(textToInsert);
    }

    clearPredictions();
  };

  // Key click handler with predictive tracking and shortcut executions
  const handleKeyClick = (char: string) => {
    // Check Alt hotkeys
    if (state.altActive) {
      if (char === '=' || char === '+') {
        onCommand?.('autoSum');
        onUpdateState({ altActive: false });
        clearPredictions();
        return;
      }
    }

    // Check Ctrl hotkeys
    if (state.ctrlActive) {
      const lower = char.toLowerCase();
      if (lower === 'n' || char === 'ى') {
        onCommand?.('new');
      } else if (lower === 'o' || char === 'خ') {
        onCommand?.('open');
      } else if (lower === 's' || char === 'س') {
        onCommand?.('save');
      } else if (lower === 'p' || char === 'ح') {
        onCommand?.('print');
      } else if (lower === 'c' || char === 'ؤ') {
        onCommand?.('copy');
      } else if (lower === 'x' || char === 'ء') {
        onCommand?.('cut');
      } else if (lower === 'v' || char === 'ر') {
        onCommand?.('paste');
      } else if (lower === 'a' || char === 'ش') {
        onCommand?.('selectAll');
      } else if (lower === 'z' || char === 'ئ') {
        onCommand?.('undo');
      } else if (lower === 'y' || char === 'إ' || char === 'غ') {
        onCommand?.('redo');
      } else if (lower === 'f' || char === 'ب') {
        onCommand?.('find');
      } else if (lower === 'h' || char === 'ا' || char === 'أ') {
        onCommand?.('replace');
      } else if (lower === 'b' || char === 'لا') {
        onCommand?.('bold');
      } else if (lower === 'i' || char === 'ه') {
        onCommand?.('italic');
      } else if (lower === 'u' || char === 'ع') {
        onCommand?.('underline');
      } else if (lower === 'e' || char === 'ث') {
        onCommand?.('alignCenter');
      } else if (lower === 'r' || char === 'ق') {
        onCommand?.('alignRight');
      } else if (lower === 'l' || char === 'م') {
        if (state.shiftActive) {
          onCommand?.('toggleFilters');
        } else {
          onCommand?.('alignLeft');
        }
      } else if (lower === 'j' || char === 'ت') {
        onCommand?.('justify');
      } else if (char === ']' || char === 'د') {
        onCommand?.('increaseFontSize');
      } else if (char === '[' || char === 'ج') {
        onCommand?.('decreaseFontSize');
      } else if (char === '1' || char === '١') {
        onCommand?.('lineSpacing1');
      } else if (char === '2' || char === '٢') {
        onCommand?.('lineSpacing2');
      } else if (char === '5' || char === '٥') {
        onCommand?.('lineSpacing1_5');
      } else if (char === ';' || char === 'ك') {
        onCommand?.('insertDate');
      } else if (char === ':' || char === 'ط') {
        onCommand?.('insertTime');
      } else {
        onKeyPress(char);
      }
      onUpdateState({ ctrlActive: false, shiftActive: false, altActive: false });
      clearPredictions();
      return;
    }

    // Normal typing
    onKeyPress(char);

    // Track predictive buffer
    if (char === ' ' || char === '\n' || char === '\t') {
      clearPredictions();
    } else {
      setPredictiveBuffer((prev) => prev + char);
    }
  };

  const handleBackspaceKey = () => {
    onBackspace();
    setPredictiveBuffer((prev) => {
      const next = prev.slice(0, -1);
      if (!next) setPredictiveSuggestions([]);
      return next;
    });
  };

  const handleEnterKey = () => {
    clearPredictions();
    onEnter();
  };

  const handleTabKey = () => {
    clearPredictions();
    onTab();
  };

  // If user switched to phone's native keyboard, render a sleek floating dock switcher
  if (isNative) {
    return (
      <div className="fixed bottom-3 left-1/2 -translate-x-1/2 z-50 no-print select-none" dir="rtl">
        <div className="bg-slate-900/95 backdrop-blur-md text-white px-3.5 py-1.5 rounded-full shadow-2xl border border-slate-700 flex items-center gap-2.5 animate-in fade-in slide-in-from-bottom-2 text-xs">
          <div className="flex items-center gap-1.5 text-slate-300">
            <Smartphone className="w-3.5 h-3.5 text-emerald-400" />
            <span className="font-semibold">لوحة مفاتيح الهاتف نشطة 📱</span>
          </div>

          <div className="w-px h-3.5 bg-slate-700" />

          <button
            onClick={toggleInputMode}
            className="flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-600 hover:bg-blue-500 text-white font-bold transition shadow-xs active:scale-95 cursor-pointer"
          >
            <KeyboardIcon className="w-3.5 h-3.5" />
            <span>التبديل للكيبورد الملحق ⌨️</span>
          </button>

          <button
            onClick={toggleAutoSwitch}
            className={`px-2 py-0.5 rounded-full text-[10px] font-bold border transition cursor-pointer ${
              autoSwitchEnabled 
                ? 'bg-emerald-900/60 text-emerald-300 border-emerald-600' 
                : 'bg-slate-800 text-slate-400 border-slate-600'
            }`}
            title="التبديل التلقائي عند التركيز أو الإدخال"
          >
            تبديل تلقائي: {autoSwitchEnabled ? 'مفعل ✓' : 'معطل'}
          </button>

          <button
            onClick={() => onUpdateState({ isOpen: false })}
            className="p-1 text-slate-400 hover:text-white rounded-full transition mr-1 cursor-pointer"
          >
            <X className="w-3.5 h-3.5" />
          </button>
        </div>
      </div>
    );
  }

  // Quick Tashkeel & Diacritics
  const tashkeelList = [
    { label: 'َ فتحة', char: '\u064E' },
    { label: 'ً تنوين فتح', char: '\u064B' },
    { label: 'ُ ضمة', char: '\u064F' },
    { label: 'ٌ تنوين ضم', char: '\u064C' },
    { label: 'ِ كسرة', char: '\u0650' },
    { label: 'ٍ تنوين كسر', char: '\u064D' },
    { label: 'ْ سكون', char: '\u0652' },
    { label: 'ّ شدة', char: '\u0651' },
    { label: 'ـ تطويل', char: '\u0640' },
  ];

  // Colors Palette for direct coloring
  const quickColors = [
    { name: 'أسود', hex: '#000000' },
    { name: 'أزرق', hex: '#0000FF' },
    { name: 'أحمر', hex: '#FF0000' },
    { name: 'أخضر', hex: '#008000' },
    { name: 'بنفسجي', hex: '#800080' },
    { name: 'وردي', hex: '#FF00FF' },
    { name: 'سماوي', hex: '#00FFFF' },
    { name: 'أصفر', hex: '#FFFF00' },
    { name: 'كحلي', hex: '#000080' },
    { name: 'رمادي', hex: '#808080' },
  ];

  // Number Row according to selected system
  const easternNumbers = [
    { char: 'ذ', shift: 'ّ', alt: '`' },
    { char: '١', shift: '!', alt: '1' },
    { char: '٢', shift: '@', alt: '2' },
    { char: '٣', shift: '#', alt: '3' },
    { char: '٤', shift: '$', alt: '4' },
    { char: '٥', shift: '%', alt: '5' },
    { char: '٦', shift: '^', alt: '6' },
    { char: '٧', shift: '&', alt: '7' },
    { char: '٨', shift: '*', alt: '8' },
    { char: '٩', shift: ')', alt: '9' },
    { char: '٠', shift: '(', alt: '0' },
    { char: '-', shift: '_', alt: 'ـ' },
    { char: '=', shift: '+', alt: '±' },
  ];

  const westernNumbers = [
    { char: 'ذ', shift: 'ّ', alt: '`' },
    { char: '1', shift: '!', alt: '١' },
    { char: '2', shift: '@', alt: '٢' },
    { char: '3', shift: '#', alt: '٣' },
    { char: '4', shift: '$', alt: '٤' },
    { char: '5', shift: '%', alt: '٥' },
    { char: '6', shift: '^', alt: '٦' },
    { char: '7', shift: '&', alt: '٧' },
    { char: '8', shift: '*', alt: '٨' },
    { char: '9', shift: '(', alt: '٩' },
    { char: '0', shift: ')', alt: '٠' },
    { char: '-', shift: '_', alt: 'ـ' },
    { char: '=', shift: '+', alt: '±' },
  ];

  const numRow = numberType === 'eastern' ? easternNumbers : westernNumbers;

  // Standard Arabic 101 row layout with shortcut annotations when Ctrl is pressed
  const arRowStandard1 = [
    { char: 'ض', shift: 'َ', ctrlHint: '' },
    { char: 'ص', shift: 'ً', ctrlHint: '' },
    { char: 'ث', shift: 'ُ', ctrlHint: 'توسيط' },
    { char: 'ق', shift: 'ٌ', ctrlHint: 'يمين' },
    { char: 'ف', shift: 'لإ', ctrlHint: '' },
    { char: 'غ', shift: 'إ', ctrlHint: 'إعادة' },
    { char: 'ع', shift: '‘', ctrlHint: 'تسطير' },
    { char: 'ه', shift: '÷', ctrlHint: 'مائل' },
    { char: 'خ', shift: '×', ctrlHint: 'فتح' },
    { char: 'ح', shift: '؛', ctrlHint: 'طباعة' },
    { char: 'ج', shift: '<', ctrlHint: 'تصغير' },
    { char: 'د', shift: '>', ctrlHint: 'تكبير' },
  ];

  const arRowStandard2 = [
    { char: 'ش', shift: 'ِ', ctrlHint: 'تحديد' },
    { char: 'س', shift: 'ٍ', ctrlHint: 'حفظ' },
    { char: 'ي', shift: ']', ctrlHint: '' },
    { char: 'ب', shift: '[', ctrlHint: 'بحث' },
    { char: 'ل', shift: 'لأ', ctrlHint: '' },
    { char: 'ا', shift: 'أ', ctrlHint: 'استبدال' },
    { char: 'ت', shift: 'ـ', ctrlHint: 'ضبط' },
    { char: 'ن', shift: '،', ctrlHint: '' },
    { char: 'م', shift: '/', ctrlHint: 'يسار' },
    { char: 'ك', shift: ':', ctrlHint: 'تاريخ' },
    { char: 'ط', shift: '"', ctrlHint: 'وقت' },
  ];

  const arRowStandard3 = [
    { char: 'ئ', shift: '~', ctrlHint: 'تراجع' },
    { char: 'ء', shift: 'ْ', ctrlHint: 'قص' },
    { char: 'ؤ', shift: '}', ctrlHint: 'نسخ' },
    { char: 'ر', shift: '{', ctrlHint: 'لصق' },
    { char: 'لا', shift: 'لآ', ctrlHint: 'غامق' },
    { char: 'ى', shift: 'آ', ctrlHint: 'جديد' },
    { char: 'ة', shift: '\'', ctrlHint: '' },
    { char: 'و', shift: ',', ctrlHint: '' },
    { char: 'ز', shift: '.', ctrlHint: '' },
    { char: 'ظ', shift: '؟', ctrlHint: '' },
  ];

  // RTL Direct Flow Order (if user selects RTL layout mode)
  const arRowRTL1 = [...arRowStandard1].reverse();
  const arRowRTL2 = [...arRowStandard2].reverse();
  const arRowRTL3 = [...arRowStandard3].reverse();

  const activeArRow1 = layoutMode === 'standard' ? arRowStandard1 : arRowRTL1;
  const activeArRow2 = layoutMode === 'standard' ? arRowStandard2 : arRowRTL2;
  const activeArRow3 = layoutMode === 'standard' ? arRowStandard3 : arRowRTL3;

  // English QWERTY
  const enRow1 = [
    { char: 'q', shift: 'Q', ctrlHint: '' },
    { char: 'w', shift: 'W', ctrlHint: '' },
    { char: 'e', shift: 'E', ctrlHint: 'Center' },
    { char: 'r', shift: 'R', ctrlHint: 'Right' },
    { char: 't', shift: 'T', ctrlHint: '' },
    { char: 'y', shift: 'Y', ctrlHint: 'Redo' },
    { char: 'u', shift: 'U', ctrlHint: 'Underline' },
    { char: 'i', shift: 'I', ctrlHint: 'Italic' },
    { char: 'o', shift: 'O', ctrlHint: 'Open' },
    { char: 'p', shift: 'P', ctrlHint: 'Print' },
    { char: '[', shift: '{', ctrlHint: 'Font-' },
    { char: ']', shift: '}', ctrlHint: 'Font+' },
  ];

  const enRow2 = [
    { char: 'a', shift: 'A', ctrlHint: 'Select' },
    { char: 's', shift: 'S', ctrlHint: 'Save' },
    { char: 'd', shift: 'D', ctrlHint: '' },
    { char: 'f', shift: 'F', ctrlHint: 'Find' },
    { char: 'g', shift: 'G', ctrlHint: '' },
    { char: 'h', shift: 'H', ctrlHint: 'Replace' },
    { char: 'j', shift: 'J', ctrlHint: 'Justify' },
    { char: 'k', shift: 'K', ctrlHint: '' },
    { char: 'l', shift: 'L', ctrlHint: 'Left' },
    { char: ';', shift: ':', ctrlHint: 'Date' },
    { char: '\'', shift: '"', ctrlHint: '' },
  ];

  const enRow3 = [
    { char: 'z', shift: 'Z', ctrlHint: 'Undo' },
    { char: 'x', shift: 'X', ctrlHint: 'Cut' },
    { char: 'c', shift: 'C', ctrlHint: 'Copy' },
    { char: 'v', shift: 'V', ctrlHint: 'Paste' },
    { char: 'b', shift: 'B', ctrlHint: 'Bold' },
    { char: 'n', shift: 'N', ctrlHint: 'New' },
    { char: 'm', shift: 'M', ctrlHint: '' },
    { char: ',', shift: '<', ctrlHint: '' },
    { char: '.', shift: '>', ctrlHint: '' },
    { char: '/', shift: '?', ctrlHint: '' },
  ];

  const getChar = (item: any) => {
    if (typeof item === 'string') {
      if (state.capsActive || state.shiftActive) {
        return item.toUpperCase();
      }
      return item;
    }
    if (state.shiftActive && item.shift) return item.shift;
    if (state.altActive && item.alt) return item.alt;
    if (state.capsActive && typeof item.char === 'string') {
      return item.char.toUpperCase();
    }
    return item.char;
  };

  return (
    <div 
      className={`select-none no-print transition-all z-50 ${
        state.isFloating 
          ? 'fixed top-14 left-1/2 -translate-x-1/2 w-full max-w-4xl px-2 shadow-2xl' 
          : 'fixed bottom-0 left-0 right-0 max-w-5xl mx-auto px-2 pb-1'
      }`}
      dir="ltr"
    >
      <div className="bg-slate-50/98 backdrop-blur-md rounded-t-2xl border border-slate-300 shadow-2xl overflow-hidden ring-1 ring-slate-900/10">
        
        {/* Top Header Bar */}
        <div 
          className="bg-gradient-to-r from-slate-200 via-slate-100 to-slate-200 border-b border-slate-300 px-2.5 flex items-center justify-between w-full select-none gap-1 overflow-x-auto scrollbar-none py-1.5"
          dir="rtl"
        >
          {/* Title & Mode Indicator */}
          <div className="flex items-center gap-1.5 shrink-0">
            <div className="w-5 h-5 rounded-md bg-blue-600 text-white flex items-center justify-center shadow-xs">
              <KeyboardIcon className="w-3 h-3" />
            </div>
            <span className="text-[11px] font-black text-slate-800 shrink-0">
              الكيبورد الملحق {mode === 'excel' ? '📊 إكسل' : '📝 وورد'}
            </span>
            <span className="text-[9.5px] px-2 py-0.5 rounded-full bg-blue-100 text-blue-800 font-extrabold border border-blue-200 shadow-2xs">
              {state.language === 'ar' ? 'العربية' : 'EN'}
            </span>
          </div>

          {/* Controls & Mode Toggles */}
          <div className="flex items-center gap-1 shrink-0">
            {/* Direct Text Color Button */}
            <button
              onClick={() => setShowColorPalette(!showColorPalette)}
              className={`flex items-center gap-1 px-2 py-1 rounded-lg text-[9px] font-bold border transition shadow-2xs cursor-pointer touch-manipulation ${
                showColorPalette ? 'bg-blue-600 text-white border-blue-700 shadow-xs' : 'bg-white hover:bg-slate-100 text-slate-700 border-slate-300'
              }`}
              title="لوحة ألوان النص السريعة"
            >
              <Palette className="w-3 h-3 text-amber-500" />
              <span>لون الخط</span>
            </button>

            {/* Layout Mode Toggle (Standard 101 vs RTL flow) */}
            <button
              onClick={toggleLayoutMode}
              className="px-2 py-1 rounded-lg bg-white hover:bg-slate-100 text-slate-700 border border-slate-300 text-[9px] font-bold shadow-2xs cursor-pointer touch-manipulation"
              title="تبديل ترتيب الحروف (قياسي ويندوز 101 / تدفق يميني RTL)"
            >
              {layoutMode === 'standard' ? 'نسق: قياسي 101' : 'نسق: يميني RTL'}
            </button>

            {/* Number System Toggle (Eastern ١٢٣ vs Western 123) */}
            <button
              onClick={toggleNumberType}
              className="px-2 py-1 rounded-lg bg-white hover:bg-slate-100 text-slate-700 border border-slate-300 text-[9px] font-bold shadow-2xs cursor-pointer touch-manipulation"
              title="تبديل نظام الأرقام (عربية مشرقية ١٢٣ / غربية 123)"
            >
              {numberType === 'eastern' ? 'أرقام: ١٢٣' : 'أرقام: 123'}
            </button>

            {/* Phone native keyboard switcher */}
            <button
              onClick={toggleInputMode}
              className="flex items-center gap-1 px-2 py-1 rounded-lg bg-blue-50 hover:bg-blue-100 text-blue-800 text-[9px] font-bold border border-blue-300 transition shadow-2xs cursor-pointer touch-manipulation"
              title="التبديل إلى كيبورد الهاتف اللمسي"
            >
              <Smartphone className="w-3 h-3 text-blue-600" />
              <span>📱 هاتف</span>
            </button>

            {/* Extra Tools Drawer */}
            <button
              onClick={() => setShowExtraMenu(!showExtraMenu)}
              className={`flex items-center gap-1 px-2 py-1 rounded-lg text-[9px] font-bold border transition shadow-2xs cursor-pointer touch-manipulation ${
                showExtraMenu ? 'bg-amber-100 text-amber-900 border-amber-400 font-black' : 'bg-white hover:bg-slate-100 text-slate-700 border-slate-300'
              }`}
              title="أدوات وتشكيل إضافية"
            >
              <Sparkles className="w-3 h-3 text-amber-600" />
              <span>تشكيل {showExtraMenu ? '▲' : '▼'}</span>
            </button>

            {/* Direct Keyboard Shortcuts Toolbar Toggle */}
            <button
              onClick={() => setShowShortcutsBar(!showShortcutsBar)}
              className={`flex items-center gap-1 px-2 py-1 rounded-lg text-[9px] font-bold border transition shadow-2xs cursor-pointer touch-manipulation ${
                showShortcutsBar ? 'bg-indigo-600 text-white border-indigo-700 font-bold' : 'bg-white hover:bg-slate-100 text-indigo-700 border-indigo-200'
              }`}
              title="إظهار / إخفاء شريط الاختصارات المباشرة"
            >
              <Zap className="w-3 h-3 text-amber-300" />
              <span>اختصارات ⚡</span>
            </button>

            {/* Secrets & Keyboard Shortcuts Modal Button */}
